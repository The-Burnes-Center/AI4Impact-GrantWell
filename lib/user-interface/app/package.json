{
  "name": "aws-genai-llm-chatbot",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "copy-shared": "mkdir -p src/common/generated && cp ../../shared/states.ts src/common/generated/states.ts",
    "predev": "npm run copy-shared",
    "prebuild": "npm run copy-shared",
    "prebuild:dev": "npm run copy-shared",
    "prepreview": "npm run copy-shared",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:theme": "node src/style.js",
    "build:dev": "tsc && cross-env NODE_ENV=development vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "format": "npx prettier --ignore-path .gitignore --write \"**/*.+(tsx|js|ts|json)\""
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "aws-amplify": "^6.20.0",
    "bootstrap": "^5.3.3",
    "diff": "^7.0.0",
    "esbuild": "^0.25.1",
    "luxon": "^3.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-json-view-lite": "^0.9.8",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.15.0",
    "react-speech-recognition": "^3.10.0",
    "react-textarea-autosize": "^8.5.4",
    "react-use-websocket": "^4.5.0",
    "recharts": "^2.15.4",
    "regenerator-runtime": "^0.14.0",
    "remark-gfm": "^4.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/luxon": "^3.3.2",
    "@types/react": "^18.2.15",
    "@types/react-bootstrap": "^0.32.37",
    "@types/react-dom": "^18.2.7",
    "@types/uuid": "^9.0.3",
    "@types/zen-observable": "^0.8.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.5.3",
    "sass": "^1.65.1",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.0.2",
    "vite": "^6.2.3",
    "zen-observable": "^0.10.0"
  },
  "overrides": {
    "sass": "^1.65.1"
  }
}

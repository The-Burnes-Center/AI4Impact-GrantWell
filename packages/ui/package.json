{
  "name": "grantwell-ui",
  "private": true,
  "version": "3.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && cross-env NODE_ENV=development vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:strict": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:colors": "node scripts/check-colors.mjs",
    "test": "vitest run",
    "stage-instance": "node scripts/stage-instance.mjs",
    "preview": "vite preview",
    "format": "npx prettier --ignore-path .gitignore --write \"**/*.+(tsx|js|ts|json)\""
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "aws-amplify": "^6.20.0",
    "bootstrap": "^5.3.3",
    "diff": "^9.0.0",
    "luxon": "^3.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-json-view-lite": "^0.9.8",
    "react-markdown": "^9.0.0",
    "react-router": "^7.18.3",
    "react-speech-recognition": "^3.10.0",
    "react-textarea-autosize": "^8.5.4",
    "recharts": "^3.10.1",
    "regenerator-runtime": "^0.14.0",
    "remark-gfm": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.3.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "sass": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "5.8.3",
    "vite": "^6.2.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sass": "^1.65.1"
  }
}

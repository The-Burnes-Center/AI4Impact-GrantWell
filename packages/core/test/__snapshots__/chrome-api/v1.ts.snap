export const CHROME_CLASSES_RETIRED: Record<string, string> = {};
export interface ChromeLink {
    label: string;
    href: string;
}
export interface ChromeUser {
    email: string;
    isAdmin: boolean;
}
export interface ChromeMenu {
    expanded: boolean;
    toggle: () => void;
    controlsId: string;
}
export interface HeaderProps {
    user?: ChromeUser;
    links: ChromeLink[];
    navigate: (href: string) => void;
    signOut: () => void;
